{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_care_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
