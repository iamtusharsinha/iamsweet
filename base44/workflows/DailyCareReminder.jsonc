          "then": "end",
          "x-base44": {
            "title": "Send daily care reminders",
            "description": "Emails all users to log blood sugar & meds"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sends a daily email reminder to all users to log their blood sugar and medications.",
  "name": "Daily Care Reminder"
}