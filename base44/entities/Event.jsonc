{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "hackathon",
        "meetup",
        "workshop",
        "talk",
        "study_group",
        "networking"
      ]
    },
    "url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "beginner_safe": {
      "type": "boolean",
      "default": false
    },
    "beginner_safe_reason": {
      "type": "string"
    },
    "learn_first_course": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attendees_count": {
      "type": "number"
    }
  },
  "required": [
    "title",
    "type",
    "url"
  ]
}