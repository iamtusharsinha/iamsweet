{
  "name": "Order",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "stripe_payment_intent": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "shipping_address": {
      "type": "object"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "items",
    "total",
    "status"
  ]
}