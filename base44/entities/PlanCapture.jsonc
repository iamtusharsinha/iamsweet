{
  "name": "PlanCapture",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "motivation": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "hours_per_week": {
      "type": "string"
    },
    "plan_course_id": {
      "type": "string"
    },
    "plan_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}